# Prosocial Environment Variables
# Copy this file to .env and fill in your values

# ===================
# SUPABASE
# ===================
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ===================
# OPENAI (Optional)
# ===================
# For AI-powered coaching features
# Get your key from: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-openai-key-here

# ===================
# GOOGLE CALENDAR (Optional)
# ===================
# For calendar integration
# Set up OAuth in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===================
# EXPO (For Push Notifications)
# ===================
# Get your project ID from: https://expo.dev
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id
